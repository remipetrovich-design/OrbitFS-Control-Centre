# ORBITFS DEV PANEL — PRODUCTION ENVIRONMENT
# Uses the SAME License Master users stored in the shared Supabase database.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

APP_URL=https://dev.incendiarynetworks.cc
APP_SESSION_SECRET=generate-a-long-random-secret

LICENSE_MASTER_URL=https://incendiarynetworks.cc/api/v1
LICENSE_MASTER_API_TOKEN=use-the-License-Master-managed-release-control-key

# Server-side GitHub credential used by Dev Panel to inspect private repos and
# dispatch manual release workflows. Also add the same secret to the Dev-panel
# GitHub repository Actions secrets for the Base packaging workflow.
# Active GitHub control profile. Use "primary" normally and "fallback" only
# while the lucaskerim123 account is rate-limited/unavailable.
ORBITFS_GITHUB_PROFILE=primary
ORBITFS_RELEASE_DISPATCH_TOKEN=use-the-primary-lucaskerim123-github-token
ORBITFS_FALLBACK_GITHUB_TOKEN=use-the-remipetrovich-design-github-token
GITHUB_API_VERSION=2022-11-28

# Primary profile overrides (normally leave these defaults unchanged).
BASE_RELEASE_REPO=lucaskerim123/V1-vercel-base
BASE_RELEASE_REF=base-release
BASE_RELEASE_WORKER_REPO=lucaskerim123/Dev-panel
BASE_RELEASE_WORKER_REF=main
BASE_RELEASE_WORKER_WORKFLOW=package-base-release.yml

ENGINE_RELEASE_REPO=lucaskerim123/V1-vercel-engine
ENGINE_RELEASE_REF=UPDATE_RELEASE
ENGINE_BASELINE_REF=main
ENGINE_RELEASE_WORKFLOW=publish-engine-release.yml

# Production Operations targets controlled from Dev Panel
LICENSE_MANAGER_REPO=lucaskerim123/Custom-licence-manager
BILLING_STORE_REPO=lucaskerim123/V2_Billing_Store
OPERATIONS_CI_WORKFLOW=ci.yml
OPERATIONS_DEPLOY_WORKFLOW=production-deploy.yml
LICENSE_MANAGER_QUICK_DEPLOY_WORKFLOW=quick-deploy.yml
BILLING_STORE_QUICK_DEPLOY_WORKFLOW=quick-redesign-deploy.yml

# Billing Store origin used by the private MCP for customer/account lookup and
# customer deployer/update execution when that context is required.
BILLING_STORE_URL=https://orbitfsstore.vercel.app

# Shared Dev Panel <-> Billing Store internal-operation authentication.
DEV_PANEL_EVENT_SECRET=replace-with-long-random-shared-event-secret


# ---------------------------------------------------------------------------
# PRIVATE DEV MCP SERVICE INTEGRATIONS
# ---------------------------------------------------------------------------
# Optional dedicated License Manager integration key. Falls back to
# LICENSE_MASTER_API_TOKEN when left blank.
LICENSE_MASTER_CONTROL_API_TOKEN=

# Out-of-band emergency recovery credential. Set this to the SAME secret as
# Custom Licence Manager's AUTHORITY_LOCKDOWN_RECOVERY_TOKEN. It is used only
# by the dedicated /lockdown/recover path while the normal API is locked.
LICENSE_MASTER_LOCKDOWN_RECOVERY_TOKEN=


# ---------------------------------------------------------------------------
# PRIVATE DEV MCP / OAUTH 2.1
# ---------------------------------------------------------------------------
# Canonical public origin and protected MCP resource.
DEV_MCP_PUBLIC_ORIGIN=https://dev.incendiarynetworks.cc
DEV_MCP_RESOURCE=https://dev.incendiarynetworks.cc/devmcp

# Browser-origin allowlist for MCP traffic.
DEV_MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://dev.incendiarynetworks.cc

# Dynamic OAuth client registration is restricted to these redirect hosts.
# ChatGPT supplies the exact redirect URI during registration.
DEV_MCP_OAUTH_REDIRECT_HOSTS=chatgpt.com,chat.openai.com,openai.com

# CIMD client_id URLs are fetched only from these trusted hosts.
# ChatGPT currently publishes stable/callback-specific metadata under chatgpt.com.
DEV_MCP_OAUTH_CIMD_HOSTS=chatgpt.com,openai.com

DEV_MCP_OAUTH_ALLOW_LOCALHOST=false


# Temporary fallback GitHub profile defaults.
FALLBACK_BASE_RELEASE_REPO=remipetrovich-design/OrbitFS-Base-System
FALLBACK_BASE_RELEASE_REF=base-release
FALLBACK_ENGINE_RELEASE_REPO=remipetrovich-design/OrbitFS_Engine
FALLBACK_ENGINE_RELEASE_REF=UPDATE_RELEASES
FALLBACK_ENGINE_BASELINE_REF=main
FALLBACK_DEV_PANEL_REPO=remipetrovich-design/OrbitFS-Control-Centre
FALLBACK_LICENSE_MANAGER_REPO=remipetrovich-design/OrbitFS-License-Administration
FALLBACK_BILLING_STORE_REPO=remipetrovich-design/OrbitFS-Billing-Shopfront
